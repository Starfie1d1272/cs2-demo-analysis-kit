{
  "name": "@cs2dak/maps",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Starfie1d1272/cs2-demo-analysis-kit.git",
    "directory": "packages/maps"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./callout-grid-browser": {
      "types": "./dist/callout-grid-browser.d.ts",
      "import": "./dist/callout-grid-browser.js",
      "default": "./dist/callout-grid-browser.js"
    },
    "./callout-grid-node": {
      "types": "./dist/callout-grid-node.d.ts",
      "import": "./dist/callout-grid-node.js",
      "default": "./dist/callout-grid-node.js"
    },
    "./tri-assets": {
      "types": "./dist/tri-assets.d.ts",
      "import": "./dist/tri-assets.js",
      "default": "./dist/tri-assets.js"
    },
    "./calibration": {
      "types": "./dist/calibration.d.ts",
      "import": "./dist/calibration.js",
      "default": "./dist/calibration.js"
    }
  },
  "files": [
    "dist",
    "callout-grid",
    "map-routes",
    "map-nav",
    "map-zones"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -b --force"
  }
}
