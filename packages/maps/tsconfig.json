{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src",
    "map-routes/*.json",
    "map-nav/*.json",
    "map-zones/*.json",
    "callout-grid/*.json"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/test-fixtures.ts",
    "src/**/test-fixtures.tsx",
    "src/**/__tests__/**"
  ]
}
